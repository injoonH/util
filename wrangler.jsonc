{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "utility-workbench",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "util.yuwol.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "utility-clipboard",
      "database_id": "4abb619b-78f9-48cf-a850-f0af9f8379ed",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "CLIPBOARD_CREATE_LIMITER",
      "namespace_id": "10001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "CLIPBOARD_READ_LIMITER",
      "namespace_id": "10002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "observability": {
    "enabled": false
  }
}
