{
  "name": "utility-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "node scripts/prepare-pdf-assets.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare-pdf-assets.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.server.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply utility-clipboard --local",
    "db:migrate:remote": "wrangler d1 migrations apply utility-clipboard --remote",
    "deploy": "node scripts/check-deployment.mjs && pnpm build && wrangler deploy"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "hono": "4.13.13",
    "jsonc-parser": "3.3.1",
    "lucide-react": "1.61.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "^4.14.8",
    "react-router-dom": "7.18.4",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/workers-types": "5.20261024.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "miniflare": "4.20260730.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
